# ===== Vision API =====
# 留空 VISION_API_KEY 则自动使用内置 Mock 识别（离线可跑通全流程）。
# 示例：agnes-2.5-flash 兼容网关（VISION_API_BASE 可填 /v1 根地址，代码会自动补全端点）
VISION_API_KEY=
VISION_API_BASE=https://apihub.agnes-ai.com/v1
VISION_MODEL=agnes-2.5-flash

# ===== AI 标题生成 =====
# 每张图片生成的 AI 标题候选数量（默认 3 条）
AI_TITLE_COUNT=3
# AI 标题最大字符数（各平台标题长度不同，可按需调整）
TITLE_MAX_LEN=60

# ===== 发布渠道 =====
# mock = 本地模拟后台（Playwright RPA 填表，默认）；api = 官方开放平台 API 骨架（未实现）
CHANNEL=mock

# ===== 批量上架 =====
# 单批上传图片上限
BATCH_IMAGE_LIMIT=20

# ===== Web 前端服务（FastAPI，替代旧 Streamlit 界面）=====
WEB_HOST=127.0.0.1
WEB_PORT=8502

# ===== 本地模拟后台 =====
MOCK_BACKEND_HOST=127.0.0.1
MOCK_BACKEND_PORT=8010

# ===== Playwright RPA =====
# true = 无头模式；false = 弹出可见浏览器（面试演示更直观）
RPA_HEADLESS=false
RPA_BROWSER=chromium
